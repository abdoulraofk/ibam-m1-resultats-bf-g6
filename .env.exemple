# Modèle des variables secrètes de la plateforme RÉSULTATS-BF.
#
#   cp .env.exemple .env      puis remplacer chaque valeur « a_changer ».
#
# Le fichier .env n'est JAMAIS versionné (voir .gitignore). Les scripts de
# provisionnement le lisent dans /vagrant/.env via scripts/commun.sh.
# Uniquement des lettres, chiffres, « _ » et « - » dans les valeurs :
# pas d'espaces ni de guillemets.

# --- PostgreSQL : compte utilisé par l'application ---
BDD_NOM=resultats
BDD_UTILISATEUR=resultats_app
BDD_MOT_DE_PASSE=a_changer

# --- PostgreSQL : compte de réplication bdd1 -> bdd2 ---
BDD_REPLICATION_UTILISATEUR=replicateur
BDD_REPLICATION_MOT_DE_PASSE=a_changer

# --- Extension E1 : authentification VRRP entre lb1 et lb2 (8 caractères max) ---
KEEPALIVED_MOT_DE_PASSE=a_changer

# --- Extension E2 : compte administrateur Grafana ---
GRAFANA_ADMIN_MOT_DE_PASSE=a_changer
